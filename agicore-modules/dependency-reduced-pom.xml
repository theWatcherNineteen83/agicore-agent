<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>agicore</artifactId>
    <groupId>de.metis</groupId>
    <version>0.2.0-evolution</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>agicore-modules</artifactId>
  <name>Metis AGI Modules</name>
  <description>Evolvable modules — planner, goal heuristics, attention scoring</description>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer />
                <transformer>
                  <mainClass>de.metis.modules.AgentMain</mainClass>
                  <manifestEntries>
                    <Automatic-Module-Name>de.metis.modules</Automatic-Module-Name>
                    <Implementation-Title>Metis AGI</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Implementation-Vendor>theWatcherNineteen83</Implementation-Vendor>
                    <Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
                  </manifestEntries>
                </transformer>
              </transformers>
              <finalName>metis-agent</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>tornadovm-gpu</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>add-tornado-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/tornado/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <dependencies>
        <dependency>
          <groupId>org.tornadovm</groupId>
          <artifactId>tornado-api</artifactId>
          <version>4.0.1-jdk21</version>
        </dependency>
        <dependency>
          <groupId>org.tornadovm</groupId>
          <artifactId>tornado-annotation</artifactId>
          <version>4.0.1-jdk21</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <repositories>
    <repository>
      <releases />
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>dfki-mlt-github</id>
      <url>https://raw.githubusercontent.com/DFKI-MLT/Maven-Repository/main/</url>
    </repository>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>marytts-mlt</id>
      <url>https://mlt.jfrog.io/artifactory/mlt-mvn-releases-local</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
</project>
